{
	"name": "pgconductor-js",
	"version": "0.1.0",
	"description": "Durable execution using only Postgres",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"pgconductor": "./dist/cli/index.js"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/psteinroe/pgconductor"
	},
	"keywords": [
		"postgres",
		"queue",
		"task",
		"job",
		"worker",
		"durable",
		"execution",
		"workflow"
	],
	"author": "psteinroe",
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"tag": "latest",
		"provenance": true
	},
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --target node --packages external && bun build cli/index.ts --outdir dist/cli --target node --packages external && tsc -p tsconfig.build.json && rollup dist/types/index.d.ts -o dist/index.d.ts -p dts && rm -rf dist/types",
		"test": "bun test",
		"test:unit": "bun test tests/unit",
		"test:integration": "bun test tests/integration",
		"typecheck": "tsc --noEmit",
		"perf": "bun perf/run.ts"
	},
	"devDependencies": {
		"@opentelemetry/api": "catalog:",
		"@opentelemetry/sdk-trace-base": "catalog:",
		"@testcontainers/postgresql": "catalog:",
		"@types/bun": "catalog:",
		"expect-type": "catalog:",
		"rollup": "catalog:",
		"rollup-plugin-dts": "catalog:",
		"typescript": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@opentelemetry/api": ">=1.4 <2"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.0.0",
		"cron-parser": "^5.4.0",
		"postgres": "^3.4.7"
	}
}
