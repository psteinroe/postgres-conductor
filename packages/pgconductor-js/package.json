{
	"name": "pgconductor-js",
	"version": "0.1.0",
	"description": "Durable execution using only Postgres",
	"type": "module",
	"main": "./dist/src/index.js",
	"module": "./dist/src/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		},
		"./testing": {
			"types": "./dist/src/testing.d.ts",
			"import": "./dist/src/testing.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"pgconductor": "./dist/cli/index.js"
	},
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/psteinroe/pgconductor"
	},
	"keywords": [
		"postgres",
		"queue",
		"task",
		"job",
		"worker",
		"durable",
		"execution",
		"workflow"
	],
	"author": "psteinroe",
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"tag": "latest",
		"provenance": true
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"typecheck": "tsc --noEmit",
		"perf": "tsx perf/run.ts"
	},
	"devDependencies": {
		"@opentelemetry/api": "catalog:",
		"@opentelemetry/sdk-trace-base": "catalog:",
		"@testcontainers/postgresql": "catalog:",
		"@types/node": "catalog:",
		"expect-type": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@opentelemetry/api": ">=1.4 <2"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.0.0",
		"cron-parser": "^5.4.0",
		"postgres": "^3.4.7"
	}
}
